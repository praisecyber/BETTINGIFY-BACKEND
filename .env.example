NODE_ENV=development
PORT=4000
DB_PATH=./data/bettingify.db
MONGODB_URI=
MONGODB_DB=bettingify
CORS_ORIGINS=http://localhost:5173,https://localhost,capacitor://localhost
# REQUIRED in production (use long random strings):
JWT_SECRET=change-me
WEBHOOK_SECRET=change-me
# Creates the first admin on startup if none exists
ADMIN_EMAIL=admin@bettingify.local
ADMIN_PASSWORD=change-me-now
# Local demo default only; set the legal minimum age for your licensed market in production.
MIN_GAMBLING_AGE=18
# Sample sportsbook fixtures are disabled by default; enable only for local testing.
DEMO_DATA=false
# Optional TheSportsDB provider key; no default/demo key is used.
THESPORTSDB_API_KEY=
# These keys enable global informational feeds (sports/quotes worldwide where the provider has coverage).
# They do not populate the server-validated bettable markets or settle wagers.
# Keep keys backend-only; never add them to frontend/.env or paste them into chat.
SPORTAPI_API_KEY=
ODDS_API_KEY=
# Jackpot entries are disabled until enabled for the licensed market.
JACKPOT_ENABLED=false
JACKPOT_TICKET_CENTS=10000
JACKPOT_MAX_ENTRIES_PER_USER=10
# Optional tuning (amounts in cents)
REGISTER_BONUS_CENTS=500
WELCOME_BONUS_MAX_CENTS=50000
BONUS_WAGER_MULT=3
